# Required for shared use (everyone who opens the site uses these):
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     # the AI analysis runs on Claude directly (used first when set)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # backup for the analysis (or the only AI key)
# Optional:
ANTHROPIC_MODEL=claude-sonnet-5-5          # Claude model for the direct API (falls back to claude-haiku-4-5-20251001)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ACCESS_CODE=                            # leave empty for an open site (anyone can search; the limits below protect your balance). If set, starting a research needs it; share https://your-site/?k=<code> as an invite link
DAILY_LIMIT=0                           # max researches per rolling 24 h on the shared keys (0 = unlimited, the default)
IP_DAILY_LIMIT=0                        # max researches per visitor (hashed IP) per rolling 24 h (0 = unlimited, the default)
REUSE_HOURS=2                           # identical topic/region/window asked again within N hours reuses the existing research (0 = always run fresh)
KV_STORE_NAME=trend-radar-jobs          # Apify key-value store used to save research results
APP_NAME=Trend Radar
